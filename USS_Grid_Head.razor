
<thead class="table-primary">
    <tr>
        @foreach (var col in Columns)
        {
            @if (col.Name == "Id")
            {
                @if (IdVisible)
                {
                    <td>@col.Name</td>
                }
                continue;
            }
            <th>@col.Name</th>
        }
        @if (IsAction)
        {
            <th>Action</th>
        }
    </tr>
</thead>
@code {
    [Parameter]
    public bool IdVisible { get; set; } = true;

    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public bool IsAction { get; set; }

    [Parameter]
    public List<GridColumn> Columns { get; set; }

}
