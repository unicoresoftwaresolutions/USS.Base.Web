@typeparam T

@if (IsEdit)
{
    <input type="text" @bind-value="Value" class="form-control" placeholder="Enter the @Name" aria-label="Name" />
}
else
{
    <b>Test: </b>
    @Value
}

@code {

    [Parameter]
    public T Value { get; set; }

    [Parameter]
    public string Name { get; set; }

    [Parameter]
    public bool IsEdit { get; set; }
}
