@using USS.Base.Model
@if (IsEdit)
{
    <input type="text" value=@(Value[Name]) @onchange="@( (ChangeEventArgs x) => { Value[Name] = x.Value; ValuesChanged.InvokeAsync(Value); })" class="form-control" placeholder="Enter the @Name" aria-label="Name" />
}
else
{
    @Value[Name]
}

@code {

    [Parameter]
    public BaseEntityModel Value { get; set; }

    [Parameter]
    public EventCallback<BaseEntityModel> ValuesChanged { get; set; }

    [Parameter]
    public string Name { get; set; }

    [Parameter]
    public bool IsEdit { get; set; }
}
