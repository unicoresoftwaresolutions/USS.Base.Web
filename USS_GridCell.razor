@using USS.Base.Model
@using USS.Base.Web.Controls.Checkbox
@using USS.Base.Web.Controls.USSDateOnly
@using USS.Base.Web.Controls.USSDateTime
@typeparam T where T : BaseEntityModel, new()


@if (Column != null)
{
    @if (IsEdit)
    {
        switch (Column.InputType)
        {
            case ControlType.Checkbox:
                <USS_CTRL_Checkbox Value="@Value.EditData[Column.Name]" Text="" ValueChanged="@( (bool? x) => { Value.EditData[Column.Name] = x??false; ValuesChanged.InvokeAsync(Value); })" Disabled="false" />
                break;
            case ControlType.Date:
                <USS_CTRL_DateOnly Value="@(Value.EditData[Column.Name] is null ? DateOnly.FromDateTime(DateTime.Now) : (DateOnly)Value.EditData[Column.Name])" Text="@Column.Name" ValueChanged="@( (DateOnly? x) => { Value.EditData[Column.Name] = x; ValuesChanged.InvokeAsync(Value); })" />
                break;
            case ControlType.DateTimeLocal:
                <USS_CTRL_DateTime Value="@(Value.EditData[Column.Name] is null ? DateTime.Now : (DateTime)Value.EditData[Column.Name])" Text="@Column.Name" ValueChanged="@( (DateTime? x) => { Value.EditData[Column.Name] = x; ValuesChanged.InvokeAsync(Value); })" />
                break;
            case ControlType.Number:
                <input type="number" value=@(Value.EditData[Column.Name] ?? "") @onchange="@( (ChangeEventArgs x) => { Value.EditData[Column.Name] = x.Value; ValuesChanged.InvokeAsync(Value); })" class="form-control" placeholder="Enter the @Column.Name" aria-label="Name" />
                break;
            default:
                <input type="text" value=@(Value.EditData[Column.Name] ?? "") @onchange="@( (ChangeEventArgs x) => { Value.EditData[Column.Name] = x.Value; ValuesChanged.InvokeAsync(Value); })" class="form-control" placeholder="Enter the @Column.Name" aria-label="Name" />
                break;
        }
    }
    else
    {

        if (Value.data[Column.Name] is null)
        {
            <b> </b>
        }
        else
        {
            if (Column.InputType == ControlType.Checkbox)
            {
                <USS_CTRL_Checkbox Value="@(Value.data[Column.Name] == true)" Text="" Disabled="true" />
            }
            else
            {
                @Value.data[Column.Name]
            }
        }
    }
}


@code {

    [Parameter]
    public BaseGridModel<T> Value{ get; set; }

    [Parameter]
    public EventCallback<BaseGridModel<T>> ValuesChanged { get; set; }

    [Parameter]
    public GridColumn Column { get; set; }
    

    [Parameter]
    public bool IsEdit { get; set; }

}
