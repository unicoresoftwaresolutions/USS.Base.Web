@using USS.Base.Model
@typeparam T where T : BaseEntityModel, new()
@if (IsEdit)
{
    <input type="text" value=@(Value.EditData[Name]??"") @onchange="@( (ChangeEventArgs x) => { Value.EditData[Name] = x.Value; ValuesChanged.InvokeAsync(Value); })" class="form-control" placeholder="Enter the @Name" aria-label="Name" />
}
else
{
    @(Value.data[Name]??"")
}

@code {

    [Parameter]
    public BaseGridModel<T> Value{ get; set; }

    [Parameter]
    public EventCallback<BaseGridModel<T>> ValuesChanged { get; set; }

    [Parameter]
    public string Name { get; set; }

    [Parameter]
    public bool IsEdit { get; set; }
}
