@using USS.Base.Model
@using USS.Base.Web.Controls.Checkbox
@typeparam T where T : BaseEntityModel, new()


@if (Column != null)
{
    @if (IsEdit)
    {
        if (Column.InputType == "checkbox")
        {
            <USS_CTRL_Checkbox Value="@(Value.data[Column.Name] == true)" Text="" Disabled="false" />
        }
        else
        {
            <input type="@Column.InputType" value=@(Value.EditData[Column.Name] ?? "") @onchange="@( (ChangeEventArgs x) => { Value.EditData[Column.Name] = x.Value; ValuesChanged.InvokeAsync(Value); })" class="form-control" placeholder="Enter the @Column.Name" aria-label="Name" />
        }
    }
    else
    {
        if(Column.InputType == "checkbox")
        {
            <USS_CTRL_Checkbox Value="@(Value.data[Column.Name] == true)" Text="" Disabled="true" />
        }
        else
        {
            @(Value.data[Column.Name] ?? "")
        }
    }
}


@code {

    [Parameter]
    public BaseGridModel<T> Value{ get; set; }

    [Parameter]
    public EventCallback<BaseGridModel<T>> ValuesChanged { get; set; }

    [Parameter]
    public GridColumn Column { get; set; }

    
    [Parameter]
    public bool IsEdit { get; set; }

}
